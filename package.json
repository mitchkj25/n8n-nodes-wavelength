{
	"name": "n8n-nodes-wavelength",
	"version": "0.2.0",
	"description": "n8n node for Wavelength: generate process flow diagrams from call notes and transcripts with the Wavelength REST API, then edit, review, summarize, and export them.",
	"license": "MIT",
	"homepage": "https://wavelengthflow.com",
	"keywords": [
		"n8n-community-node-package",
		"wavelength",
		"process map",
		"flowchart",
		"diagram",
		"mermaid"
	],
	"author": {
		"name": "Wavelength",
		"email": "support@wavelengthflow.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/mitchkj25/n8n-nodes-wavelength.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/WavelengthApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Wavelength/Wavelength.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.51.4",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
